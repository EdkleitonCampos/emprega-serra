# Copie os valores para as variáveis de ambiente do serviço de hospedagem.
# Gere SECRET_KEY com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=COLOQUE_UMA_CHAVE_ALEATORIA_LONGA_AQUI
COOKIE_SECURE=1
FLASK_DEBUG=0
DATABASE_PATH=/caminho/privado/persistente/emprega_serra.db
# Em produção com mais de um processo/instância, use Redis privado:
RATELIMIT_STORAGE_URI=redis://USUARIO:SENHA@HOST:PORT/0

# Notificações por e-mail (opcional)
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Opcional: WhatsApp de atendimento, com DDD (e código 55 opcional).
SUPPORT_WHATSAPP=
